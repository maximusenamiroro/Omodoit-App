<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- FORCE HTTPS FOR ALL DOMAINS - Required for Play Store -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Explicitly enforce HTTPS for Supabase and Agora -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">xiwdqvoadkcodcgtqxfy.supabase.co</domain>
        <domain includeSubdomains="true">agora.io</domain>
    </domain-config>
</network-security-config>
